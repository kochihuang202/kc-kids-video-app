{
  "name": "kc-kids-video-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && wrangler deploy",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:regression": "playwright test e2e/regressions",
    "test:regression:playback": "playwright test e2e/regressions/playback-position-stability.spec.ts",
    "test:regression:keyboard-seek": "playwright test e2e/regressions/player-keyboard-seek.spec.ts",
    "test:regression:parent-devices": "playwright test e2e/regressions/parent-device-list.spec.ts",
    "test:regression:media-retry": "playwright test e2e/regressions/media-auto-retry.spec.ts",
    "test:regression:d1-cost": "vitest run test/d1-cost-regressions.spec.ts test/learning-leisure.spec.ts",
    "test:regression:recents": "playwright test e2e/regressions/recent-card-width.spec.ts",
    "test:feature:learning-leisure": "playwright test e2e/features/learning-leisure-flow.spec.ts",
    "test:feature:downloads": "playwright test e2e/features/download-series.spec.ts",
    "test:e2e": "playwright test",
    "test:regression:ui": "playwright test --ui",
    "secrets:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-secrets.ps1",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.2",
    "vite": "^8.2.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0"
  }
}
