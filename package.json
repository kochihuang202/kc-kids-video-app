    "vitest": "~4.1.0",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "class-variance-authority": "^0.7.1",
