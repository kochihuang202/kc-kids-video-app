{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mother-daughter-picturebooks",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/media/*"]
  },
  "r2_buckets": [{ "binding": "BOOK_IMAGES", "bucket_name": "mother-daughter-picturebooks-assets" }]
}
