{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shimajiro-reading",
  "account_id": "eba7a9eadf07a5e606c2023482e787af",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "preview_urls": false,
  "main": "./worker/progress.mjs",
  "d1_databases": [{
    "binding": "PROGRESS",
    "database_name": "shimajiro-reading-progress",
    "database_id": "379aa26c-1b45-4ed8-ad76-742cea18c166",
    "migrations_dir": "./migrations"
  }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
