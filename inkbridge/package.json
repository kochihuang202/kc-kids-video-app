{
  "name": "inkbridge",
  "productName": "InkBridge",
  "version": "0.6.0",
  "description": "InkBridge 墨橋 — independent CanvasKit whiteboard",
  "private": true,
  "main": "src/main/main.cjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && node scripts/start.cjs",
    "test:unit": "node --test tests/core.test.mjs tests/persistence.test.mjs tests/database.test.cjs tests/rich-document.test.mjs",
    "test:desktop": "npm run build && playwright test",
    "test": "npm run test:unit && npm run test:desktop",
    "package:win": "npm run build && node scripts/package.cjs",
    "test:package": "node scripts/test-package.cjs",
    "prepare:web-share": "node scripts/web-share/prepare.cjs",
    "test:web-share": "node --test tests/web-share-data.test.cjs tests/web-share-export.test.cjs && node scripts/web-share/check-browser.cjs",
    "test:web-share:desktop": "node scripts/web-share/check-desktop.cjs",
    "test:share": "node --test tests/share-coordinator.test.cjs tests/share-panel-selection.test.cjs tests/share-images.test.cjs tests/share-cloud.test.cjs tests/web-share-data.test.cjs tests/web-share-export.test.cjs tests/attachment-response.test.cjs",
    "build:share-site": "node scripts/web-share/build-site.cjs"
  },
  "dependencies": {
    "@lexical/code": "0.53.0",
    "@lexical/code-core": "0.53.0",
    "@lexical/code-prism": "0.53.0",
    "@lexical/history": "0.53.0",
    "@lexical/link": "0.53.0",
    "@lexical/list": "0.53.0",
    "@lexical/markdown": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@lexical/selection": "0.53.0",
    "@lexical/table": "0.53.0",
    "bmp-js": "0.1.0",
    "canvaskit-wasm": "0.42.0",
    "lexical": "0.53.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "electron": "45.1.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.26"
  }
}
