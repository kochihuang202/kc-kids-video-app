{
  "name": "inkbridge",
  "productName": "InkBridge",
  "version": "0.1.0",
  "description": "InkBridge 墨橋 — independent CanvasKit whiteboard",
  "private": true,
  "main": "src/main/main.cjs",
  "scripts": {
    "start": "node scripts/start.cjs",
    "test:unit": "node --test tests/core.test.mjs",
    "test:desktop": "playwright test",
    "test": "npm run test:unit && npm run test:desktop",
    "package:win": "node scripts/package.cjs",
    "test:package": "node scripts/test-package.cjs"
  },
  "dependencies": {
    "canvaskit-wasm": "0.42.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "@playwright/test": "1.64.1",
    "@electron/packager": "20.0.0"
  }
}
